import rally.base_agent
import rally.review_results
from rally.review_results import ReviewVerdict


# Group the carried base fields when the child only keeps the shared review
# body and example.
output schema EngineeringReviewSchema[rally.review_results.BaseRallyReviewSchema]: "Engineering Review Schema"
    inherit {verdict, reviewed_artifact, analysis_performed, findings_first, current_artifact, next_owner, failure_detail}

    override example:
        verdict: "accept"
        reviewed_artifact: "home:issue.md"
        analysis_performed: "The architect pass names the real repo path, stays on the current branch, and gives Developer one clear next step."
        findings_first: "The architect pass is ready for development."
        current_artifact: "home:issue.md"
        next_owner: "developer"
        failure_detail: null


# Keep the JSON shape explicit because the schema override is the main thing a
# reader needs to spot here.
output shape EngineeringReviewJson[rally.review_results.BaseRallyReviewJson]: "Engineering Review JSON"
    inherit kind
    override schema: EngineeringReviewSchema
    inherit field_notes


schema ArchitectReviewContract: "Architect Review Contract"
    sections:
        summary: "Summary"
            "Summarize whether the architect shaped the issue into a real build step."

    gates:
        issue_understood: "Issue Understood"
            "Confirm the issue is read in plain words."

        repo_plan_real: "Repo Plan Real"
            "Confirm the plan uses the real demo repo and current branch."

        next_step_clear: "Next Step Clear"
            "Confirm Developer gets one clear next build step."


schema DeveloperReviewContract: "Developer Review Contract"
    sections:
        summary: "Summary"
            "Summarize whether the developer changed the repo in the right direction."

    gates:
        requested_change_present: "Requested Change Present"
            "Confirm the claimed change really landed in the repo."

        proof_recorded: "Proof Recorded"
            "Confirm the note says what was run or why proof was deferred."

        commit_state_clear: "Commit State Clear"
            "Confirm the note says whether a commit happened."


schema QaReviewContract: "QA Review Contract"
    sections:
        summary: "Summary"
            "Summarize whether the issue now meets the request."

    gates:
        requirements_met: "Requirements Met"
            "Confirm the feature, docs, and tests now match the issue."

        proof_real: "Proof Real"
            "Confirm the proof is real and easy to read back."

        finish_ready: "Finish Ready"
            "Confirm the flow can honestly end now."


output EngineeringReviewResponse[rally.review_results.BaseRallyReviewResponse]: "Engineering Review Response"
    inherit target
    override shape: EngineeringReviewJson
    inherit {requirement, verdict, findings_first, failure_detail}

    override reviewed_artifact: "Reviewed Artifact"
        "Use `home:issue.md`."

    override analysis_performed: "Review Summary"
        "Explain the review in 2-4 plain sentences."

    override current_artifact: "Current Artifact" when present(current_artifact):
        "Use `home:issue.md`."

    override next_owner: "Next Owner" when present(next_owner):
        "Use {{Architect:key}} when Architect needs another pass."
        "Use {{Developer:key}} when the next repo change belongs to Developer."
        "Use {{QaDocsTester:key}} when the accepted developer pass is ready for QA."

    inherit {trust_surface, standalone_read}


output EngineeringReviewFinalResponse[EngineeringReviewResponse]: "Engineering Review Final Response"
    inherit {target, shape, requirement, verdict, reviewed_artifact, analysis_performed, findings_first, current_artifact, next_owner, failure_detail, trust_surface, standalone_read}


review_family EngineeringReviewFamily: "Engineering Review"
    comment_output: EngineeringReviewResponse

    # Bare names mean identity binds.
    # Keep explicit paths only where the review semantic name changes.
    # Doctrine v5 has no `final_output.review_fields: <SharedDecl>` bind,
    # so each reviewer agent restates this same shorthand in AGENTS.prompt.
    # When that gap lands, collapse the per-agent repeats to one shared ref.
    fields:
        verdict
        reviewed_artifact
        analysis: analysis_performed
        readback: findings_first
        current_artifact
        blocked_gate: failure_detail.blocked_gate
        failing_gates: failure_detail.failing_gates
        next_owner


# TODO(doctrine P2): when `override gates:` on review_case lands, per-case
# reviews below can narrow or rename individual gate copy without restating
# the whole `contract_checks:` block. Today each review repeats the rejects.
review ArchitectReview[EngineeringReviewFamily]: "Architect Review"
    subject: IssueLedger
    contract: ArchitectReviewContract
    inherit fields

    contract_checks: "Contract Checks"
        reject contract.issue_understood when IssueLedger.issue_not_understood
        reject contract.repo_plan_real when IssueLedger.repo_plan_unreal
        reject contract.next_step_clear when IssueLedger.next_step_unclear
        accept "The architect review contract passes." when contract.passes

    on_accept:
        current artifact IssueLedger via EngineeringReviewResponse.current_artifact
        route "Accepted architecture goes to Developer." -> Developer

    on_reject:
        current artifact IssueLedger via EngineeringReviewResponse.current_artifact
        route "Architect needs another pass." -> Architect


review DeveloperReview[EngineeringReviewFamily]: "Developer Review"
    subject: IssueLedger
    contract: DeveloperReviewContract
    inherit fields

    contract_checks: "Contract Checks"
        reject contract.requested_change_present when IssueLedger.requested_change_absent
        reject contract.proof_recorded when IssueLedger.proof_unrecorded
        reject contract.commit_state_clear when IssueLedger.commit_state_unclear
        accept "The developer review contract passes." when contract.passes

    on_accept:
        current artifact IssueLedger via EngineeringReviewResponse.current_artifact
        route "Accepted development goes to QA." -> QaDocsTester

    on_reject:
        current artifact IssueLedger via EngineeringReviewResponse.current_artifact
        route "Developer needs another pass." -> Developer


review QaReview[EngineeringReviewFamily]: "QA Review"
    subject: IssueLedger
    contract: QaReviewContract
    inherit fields

    contract_checks: "Contract Checks"
        reject contract.requirements_met when IssueLedger.requirements_unmet
        reject contract.proof_real when IssueLedger.proof_unreal
        reject contract.finish_ready when IssueLedger.finish_not_ready
        accept "The QA review contract passes." when contract.passes

    on_accept:
        current artifact IssueLedger via EngineeringReviewResponse.current_artifact

    on_reject:
        current artifact IssueLedger via EngineeringReviewResponse.current_artifact
        route "QA found work that still belongs in the repo." -> Developer
